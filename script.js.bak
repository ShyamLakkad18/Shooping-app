/* ================= HELPERS ================= */

function formatPrice(price) {
  return "₹" + Number(price).toLocaleString("en-IN");
}


function categoryName(category) {

  const names = {
    fashion: "Fashion",
    electronics: "Electronics",
    shoes: "Shoes",
    beauty: "Beauty",
    home: "Home",
    gaming: "Gaming",
    books: "Books",
    innerwear: "Innerwear"
  };

  return names[category] || "Products";
}


function stars(rating) {

  let result = "";

  for (let i = 1; i <= 5; i++) {

    if (rating >= i) {
      result += '<i class="fa-solid fa-star"></i>';
    } else if (rating >= i - .5) {
      result += '<i class="fa-solid fa-star-half-stroke"></i>';
    } else {
      result += '<i class="fa-regular fa-star"></i>';
    }

  }

  return result;
}


/* ================= LIVE / REAL-TIME HELPERS ================= */

function getStockBadge(productId) {

  const stock = liveStockLevels[productId];

  if (stock === undefined || stock > 15) {
    return "";
  }

  const critical = stock <= 6;

  return `
    <span class="stock-left ${critical ? "critical" : ""}">
      <i class="fa-solid fa-bolt"></i>
      Only ${stock} left
    </span>
  `;

}


function getViewerLine(productId) {

  const viewers = liveViewerCounts[productId] || 0;

  if (viewers < 12) return "";

  return `
    <div class="live-viewers">
      <i class="fa-solid fa-eye"></i>
      ${viewers} people viewing this right now
    </div>
  `;

}


function getTrendingBadge(product) {

  if (product.reviews < 2000) return "";

  return `
    <span class="trending-badge">
      <i class="fa-solid fa-fire"></i>
      Trending
    </span>
  `;

}


/* Nudge live viewer counts and stock levels gently, like real dashboards do */
function tickLiveNumbers() {

  products.forEach(product => {

    const drift = Math.floor(Math.random() * 5) - 2;
    liveViewerCounts[product.id] = Math.max(
      4,
      liveViewerCounts[product.id] + drift
    );

    if (liveStockLevels[product.id] > 2 && Math.random() < 0.12) {
      liveStockLevels[product.id] -= 1;
    }

  });

  renderProducts();
  renderDeals();
  renderMenProducts();
  renderWomenProducts();

}


setInterval(tickLiveNumbers, 12000);


/* Live "someone just bought this" activity popup */
function showLiveActivityPopup() {

  const activityEl = document.getElementById("liveActivity");

  if (!activityEl || liveActivityDismissed) return;

  const product =
    products[Math.floor(Math.random() * products.length)];

  const name =
    liveFirstNames[Math.floor(Math.random() * liveFirstNames.length)];

  const city =
    liveCities[Math.floor(Math.random() * liveCities.length)];

  const minutesAgo = 1 + Math.floor(Math.random() * 8);

  const imgEl = document.getElementById("liveActivityImg");
  const textEl = document.getElementById("liveActivityText");
  const timeEl = document.getElementById("liveActivityTime");

  if (imgEl) {
    imgEl.src = product.image;
    imgEl.alt = product.name;
  }

  if (textEl) {
    textEl.textContent = `${name} from ${city} just bought "${product.name}"`;
  }

  if (timeEl) {
    timeEl.textContent = `${minutesAgo} minute${minutesAgo > 1 ? "s" : ""} ago`;
  }

  activityEl.classList.add("active");

  clearTimeout(liveActivityTimer);

  liveActivityTimer = setTimeout(() => {
    activityEl.classList.remove("active");
  }, 5500);

}


function startLiveActivityLoop() {

  /* First popup appears after a short delay, then repeats every ~9-16s */
  setTimeout(showLiveActivityPopup, 4000);

  setInterval(() => {

    const gap = 9000 + Math.random() * 7000;

    setTimeout(showLiveActivityPopup, gap);

  }, 16000);

}


const liveActivityClose = document.getElementById("liveActivityClose");

if (liveActivityClose) {

  liveActivityClose.addEventListener("click", () => {

    const activityEl = document.getElementById("liveActivity");

    if (activityEl) {
      activityEl.classList.remove("active");
    }

    liveActivityDismissed = true;

    clearTimeout(liveActivityTimer);

  });

}


/* ================= FILTER ================= */

function getFilteredProducts() {

  return products.filter(product => {

    const categoryMatch =
      currentCategory === "all" ||
      product.category === currentCategory;

    const searchMatch =
      product.name
        .toLowerCase()
        .includes(currentSearch.toLowerCase());

    return categoryMatch && searchMatch;

  });

}


function setCategory(category) {

  currentCategory = category;
  currentSearch = "";

  if (searchInput) {
    searchInput.value = "";
  }

  if (productTitle) {
    productTitle.textContent =
      category === "all"
        ? "Popular Products"
        : `${categoryName(category)} Collection`;
  }

  renderProducts(true);

  const productsSection =
    document.getElementById("products");

  if (productsSection) {
    productsSection.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
  }

  closeSidebar();

}


function updateFilterButtons() {

  document
    .querySelectorAll(".filter-btn")
    .forEach(button => {

      button.classList.toggle(
        "active",
        button.dataset.category === currentCategory
      );

    });

}


/* ================= PRODUCT CARD ================= */

function productCard(product, index = 0) {

  const liked =
    wishlist.includes(product.id);

  return `

    <article class="product-card reveal" style="--card-index:${index % 12}">

      <div
        class="product-image"
        data-product="${product.id}"
      >

        <span class="discount-badge">
          ${product.discount}% OFF
        </span>

        ${getTrendingBadge(product)}

        <button
          class="wishlist ${liked ? "active" : ""}"
          data-wishlist="${product.id}"
          aria-label="Wishlist"
        >
          <i class="${liked ? "fa-solid" : "fa-regular"} fa-heart"></i>
        </button>

        <img
          src="${product.image}"
          alt="${product.name}"
          loading="lazy"
        >

        <button class="quick-view-btn" data-product="${product.id}">
          <i class="fa-solid fa-eye"></i>
          Quick View
        </button>

      </div>

      <div class="product-info">

        <span class="product-category">
          ${categoryName(product.category)}
        </span>

        <h3
          class="product-name"
          data-product="${product.id}"
        >
          ${product.name}
        </h3>

        <div class="rating">

          <span class="stars">
            ${stars(product.rating)}
          </span>

          <span class="rating-count">
            ${product.rating}
            (${product.reviews.toLocaleString("en-IN")})
          </span>

        </div>

        ${getViewerLine(product.id)}

        <div class="price-row">

          <strong class="price">
            ${formatPrice(product.price)}
          </strong>

          <span class="old-price">
            ${formatPrice(product.oldPrice)}
          </span>

        </div>

        ${getStockBadge(product.id)}

        <button
          class="add-cart"
          data-add-cart="${product.id}"
        >
          <span class="add-cart-label">
            <i class="fa-solid fa-cart-plus"></i>
            Add to Cart
          </span>
        </button>

      </div>

    </article>

  `;
}


/* Skeleton placeholder markup shown briefly during category/search switches */
function skeletonCard() {
  return `
    <div class="product-skeleton">
      <div class="skeleton-image"></div>
      <div class="skeleton-line"></div>
      <div class="skeleton-line short"></div>
    </div>
  `;
}


/* ================= RENDER PRODUCTS ================= */

let productRenderToken = 0;

function renderProducts(withTransition = false) {

  if (!productGrid) return;

  const filtered =
    getFilteredProducts();

  const paint = () => {

    productGrid.innerHTML =
      filtered.map((product, index) => productCard(product, index)).join("");

    if (noResults) {
      noResults.classList.toggle(
        "active",
        filtered.length === 0
      );
    }

    updateFilterButtons();

    productGrid.classList.remove("switching");

    setTimeout(initReveal, 50);

  };

  if (!withTransition) {
    paint();
    return;
  }

  /* Smooth Amazon-like transition: brief skeleton shimmer before new results paint in */
  const token = ++productRenderToken;

  productGrid.classList.add("switching");

  setTimeout(() => {

    if (token !== productRenderToken) return;

    productGrid.innerHTML =
      Array.from({ length: Math.min(filtered.length || 4, 8) })
        .map(skeletonCard)
        .join("");

    setTimeout(() => {

      if (token !== productRenderToken) return;

      paint();

    }, 260);

  }, 120);

}


/* ================= DEALS ================= */

function renderDeals() {

  if (!dealProducts) return;

  const deals =
    [...products]
      .sort((a, b) => b.discount - a.discount)
      .slice(0, 4);

  dealProducts.innerHTML =
    deals.map((product, index) => productCard(product, index)).join("");

}


/* ================= MEN PRODUCTS ================= */

function renderMenProducts() {

  if (!menProductsGrid) return;

  const menProducts =
    products
      .filter(product => product.gender === "men")
      .slice(0, 8);

  menProductsGrid.innerHTML =
    menProducts.map((product, index) => productCard(product, index)).join("");

}


/* ================= WOMEN PRODUCTS ================= */

function renderWomenProducts() {

  if (!womenProductsGrid) return;

  const womenProducts =
    products
      .filter(product => product.gender === "women")
      .slice(0, 8);

  womenProductsGrid.innerHTML =
    womenProducts.map((product, index) => productCard(product, index)).join("");

}


/* ================= SEARCH ================= */

function performSearch() {

  if (!searchInput) return;

  currentSearch =
    searchInput.value.trim();

  currentCategory =
    searchCategory && searchCategory.value !== "all"
      ? searchCategory.value
      : "all";

  if (productTitle) {
    productTitle.textContent =
      currentSearch
        ? `Search Results for "${currentSearch}"`
        : "Popular Products";
  }

  renderProducts(true);

  const productsSection =
    document.getElementById("products");

  if (productsSection) {
    productsSection.scrollIntoView({
      behavior: "smooth"
    });
  }

}


const searchBtn =
  document.getElementById("searchBtn");

if (searchBtn) {
  searchBtn.addEventListener(
    "click",
    performSearch
  );
}


if (searchInput) {
  searchInput.addEventListener(
    "keydown",
    event => {
      if (event.key === "Enter") {
        performSearch();
      }
    }
  );
}


/* ================= CART ================= */

function saveCart() {
  localStorage.setItem(
    "shopnovaCart",
    JSON.stringify(cart)
  );
}


function addToCart(id) {

  const product =
    products.find(p => p.id === id);

  if (!product) return;

  const existing =
    cart.find(item => item.id === id);

  if (existing) {
    existing.quantity++;
  } else {
    cart.push({
      id,
      quantity: 1
    });
  }

  saveCart();
  renderCart();

  showToast(
    `${product.name} added to cart`
  );

  animateCartIcon();

}


function removeFromCart(id) {

  cart =
    cart.filter(item => item.id !== id);

  saveCart();
  renderCart();

}


function changeQuantity(id, amount) {

  const item =
    cart.find(item => item.id === id);

  if (!item) return;

  item.quantity += amount;

  if (item.quantity <= 0) {
    removeFromCart(id);
    return;
  }

  saveCart();
  renderCart();

}


function renderCart() {

  if (!cartItems) return;

  if (cart.length === 0) {

    cartItems.innerHTML = `
      <div class="empty-cart">
        <i class="fa-solid fa-cart-shopping"></i>
        <h3>Your cart is empty</h3>
        <p>Add products to see them here.</p>
      </div>
    `;

  } else {

    cartItems.innerHTML =
      cart.map(item => {

        const product =
          products.find(p => p.id === item.id);

        if (!product) return "";

        return `
          <div class="cart-item">

            <img
              src="${product.image}"
              alt="${product.name}"
            >

            <div class="cart-item-info">

              <h4>${product.name}</h4>

              <div class="cart-item-price">
                ${formatPrice(product.price * item.quantity)}
              </div>

              <div class="quantity">

                <button
                  data-quantity="${product.id}"
                  data-change="-1"
                >
                  −
                </button>

                <span>${item.quantity}</span>

                <button
                  data-quantity="${product.id}"
                  data-change="1"
                >
                  +
                </button>

              </div>

              <button
                class="remove-cart"
                data-remove="${product.id}"
              >
                Remove
              </button>

            </div>

          </div>
        `;

      }).join("");

  }

  let total = 0;
  let count = 0;

  cart.forEach(item => {

    const product =
      products.find(p => p.id === item.id);

    if (!product) return;

    total +=
      product.price * item.quantity;

    count += item.quantity;

  });

  if (cartTotal) {
    cartTotal.textContent =
      formatPrice(total);
  }

  if (cartCount) {
    cartCount.textContent =
      count;
  }

}


/* ================= CART EVENTS ================= */

document.addEventListener(
  "click",
  event => {

    const add =
      event.target.closest("[data-add-cart]");

    if (add) {

      addToCart(
        Number(add.dataset.addCart)
      );

      if (add.classList.contains("add-cart")) {

        const label = add.querySelector(".add-cart-label");
        const originalHTML = label ? label.innerHTML : null;

        add.classList.add("added");

        if (label) {
          label.innerHTML = '<i class="fa-solid fa-check"></i> Added!';
        }

        setTimeout(() => {

          add.classList.remove("added");

          if (label && originalHTML) {
            label.innerHTML = originalHTML;
          }

        }, 1300);

      }

      return;
    }

    const quantity =
      event.target.closest("[data-quantity]");

    if (quantity) {

      changeQuantity(
        Number(quantity.dataset.quantity),
        Number(quantity.dataset.change)
      );

      return;
    }

    const remove =
      event.target.closest("[data-remove]");

    if (remove) {

      removeFromCart(
        Number(remove.dataset.remove)
      );

    }

  }
);


/* ================= CART DRAWER ================= */

function openCart() {

  if (cartDrawer) {
    cartDrawer.classList.add("active");
  }

  if (cartOverlay) {
    cartOverlay.classList.add("active");
  }

  document.body.classList.add("drawer-open");

}


function closeCart() {

  if (cartDrawer) {
    cartDrawer.classList.remove("active");
  }

  if (cartOverlay) {
    cartOverlay.classList.remove("active");
  }

  document.body.classList.remove("drawer-open");

}


const cartBtn =
  document.getElementById("cartBtn");

const closeCartBtn =
  document.getElementById("closeCart");

if (cartBtn) {
  cartBtn.addEventListener(
    "click",
    openCart
  );
}

if (closeCartBtn) {
  closeCartBtn.addEventListener(
    "click",
    closeCart
  );
}

if (cartOverlay) {
  cartOverlay.addEventListener(
    "click",
    closeCart
  );
}


/* ================= CART ANIMATION ================= */

function animateCartIcon() {

  const icon =
    document.querySelector(".cart-icon");

  if (!icon) return;

  icon.animate(
    [
      { transform: "scale(1)" },
      { transform: "scale(1.35) rotate(-8deg)" },
      { transform: "scale(1) rotate(0)" }
    ],
    {
      duration: 450,
      easing: "ease-out"
    }
  );

}


/* ================= WISHLIST ================= */

function toggleWishlist(id) {

  const product =
    products.find(p => p.id === id);

  if (!product) return;

  if (wishlist.includes(id)) {

    wishlist =
      wishlist.filter(item => item !== id);

    showToast(
      `${product.name} removed from wishlist`
    );

  } else {

    wishlist.push(id);

    showToast(
      `${product.name} added to wishlist ❤️`
    );

  }

  localStorage.setItem(
    "shopnovaWishlist",
    JSON.stringify(wishlist)
  );

  renderProducts();
  renderDeals();
  renderMenProducts();
  renderWomenProducts();

}


document.addEventListener(
  "click",
  event => {

    const button =
      event.target.closest("[data-wishlist]");

    if (!button) return;

    event.stopPropagation();

    toggleWishlist(
      Number(button.dataset.wishlist)
    );

  }
);


/* ================= PRODUCT MODAL ================= */

function openProductModal(id) {

  const product =
    products.find(p => p.id === id);

  if (!product || !modalOverlay) return;

  const modalContent =
    document.getElementById("modalContent");

  if (!modalContent) return;

  const viewers = liveViewerCounts[id] || 0;
  const stock = liveStockLevels[id];

  modalContent.innerHTML = `

    <div class="modal-product">

      <div class="modal-image">
        <img
          src="${product.image}"
          alt="${product.name}"
        >
      </div>

      <div class="modal-details">

        <span class="product-category">
          ${categoryName(product.category)}
        </span>

        <h2 class="product-name">
          ${product.name}
        </h2>

        <div class="rating">

          <span class="stars">
            ${stars(product.rating)}
          </span>

          <span class="rating-count">
            ${product.rating}
            (${product.reviews.toLocaleString("en-IN")} reviews)
          </span>

        </div>

        ${viewers >= 12 ? `
          <div class="modal-live-viewers">
            <i class="fa-solid fa-eye"></i>
            ${viewers} people are viewing this product right now
          </div>
        ` : ""}

        <div class="modal-price">
          ${formatPrice(product.price)}
        </div>

        <div class="price-row">

          <span class="old-price">
            ${formatPrice(product.oldPrice)}
          </span>

          <strong style="color:#e53935">
            ${product.discount}% OFF
          </strong>

        </div>

        <p class="modal-description">
          ${product.description}
        </p>

        ${stock !== undefined && stock <= 15 ? `
          <div style="margin-bottom:14px">${getStockBadge(id)}</div>
        ` : ""}

        <div class="modal-stock">
          <i class="fa-solid fa-circle-check"></i>
          In Stock
        </div>

        <button
          class="primary-btn"
          data-add-cart="${product.id}"
        >
          <i class="fa-solid fa-cart-plus"></i>
          Add to Cart
        </button>

      </div>

    </div>

  `;

  modalOverlay.classList.add("active");

  document.body.classList.add("modal-open");

}


function closeProductModal() {

  if (modalOverlay) {
    modalOverlay.classList.remove("active");
  }

  document.body.classList.remove("modal-open");

}


document.addEventListener(
  "click",
  event => {

    const element =
      event.target.closest("[data-product]");

    if (!element) return;

    if (
      event.target.closest("[data-wishlist]")
    ) {
      return;
    }

    openProductModal(
      Number(element.dataset.product)
    );

  }
);


const modalClose =
  document.getElementById("modalClose");

if (modalClose) {
  modalClose.addEventListener(
    "click",
    closeProductModal
  );
}


if (modalOverlay) {
  modalOverlay.addEventListener(
    "click",
    event => {

      if (event.target === modalOverlay) {
        closeProductModal();
      }

    }
  );
}


/* ================= CATEGORY EVENTS ================= */

document.addEventListener(
  "click",
  event => {

    const button =
      event.target.closest("[data-category]");

    if (!button) return;

    const category =
      button.dataset.category;

    if (
      category === "all" ||
      products.some(
        product =>
          product.category === category
      )
    ) {
      setCategory(category);
    }

  }
);


/* ================= SIDEBAR ================= */

function openSidebar() {

  if (sidebar) {
    sidebar.classList.add("active");
  }

  if (overlay) {
    overlay.classList.add("active");
  }

  document.body.classList.add("drawer-open");

}


function closeSidebar() {

  if (sidebar) {
    sidebar.classList.remove("active");
  }

  if (overlay) {
    overlay.classList.remove("active");
  }

  document.body.classList.remove("drawer-open");

}


const menuBtn =
  document.getElementById("menuBtn");

const closeSidebarBtn =
  document.getElementById("closeSidebar");

if (menuBtn) {
  menuBtn.addEventListener(
    "click",
    openSidebar
  );
}

if (closeSidebarBtn) {
  closeSidebarBtn.addEventListener(
    "click",
    closeSidebar
  );
}

if (overlay) {
  overlay.addEventListener(
    "click",
    closeSidebar
  );
}


/* ================= MODERN AD SLIDER ================= */

const adSlides =
  document.querySelectorAll(".ad-slide");

const adDots =
  document.querySelectorAll(".ad-dots span");


function showAd(index) {

  if (!adSlides.length) return;

  adIndex =
    (index + adSlides.length) %
    adSlides.length;

  adSlides.forEach(
    (slide, i) => {

      slide.classList.toggle(
        "active",
        i === adIndex
      );

    }
  );

  adDots.forEach(
    (dot, i) => {

      dot.classList.toggle(
        "active",
        i === adIndex
      );

    }
  );

}


function nextAd() {
  showAd(adIndex + 1);
}


function previousAd() {
  showAd(adIndex - 1);
}


function startAdSlider() {

  if (!adSlides.length) return;

  clearInterval(adTimer);

  /* AUTO CHANGE EVERY 3 SECONDS */
  adTimer =
    setInterval(
      nextAd,
      3000
    );

}


const adNext =
  document.getElementById("adNext");

const adPrev =
  document.getElementById("adPrev");

if (adNext) {
  adNext.addEventListener(
    "click",
    () => {

      nextAd();
      startAdSlider();

    }
  );
}

if (adPrev) {
  adPrev.addEventListener(
    "click",
    () => {

      previousAd();
      startAdSlider();

    }
  );
}


adDots.forEach(
  (dot, index) => {

    dot.addEventListener(
      "click",
      () => {

        showAd(index);
        startAdSlider();

      }
    );

  }
);


/* ================= PAUSE AD ON HOVER ================= */

const heroAd =
  document.getElementById("heroAd");

if (heroAd) {

  heroAd.addEventListener(
    "mouseenter",
    () => clearInterval(adTimer)
  );

  heroAd.addEventListener(
    "mouseleave",
    startAdSlider
  );

}

showAd(0);
startAdSlider();


/* ================= COUNTDOWN ================= */

function updateCountdown() {

  if (dealSeconds <= 0) {
    dealSeconds = 8 * 60 * 60;
  }

  const hours =
    Math.floor(dealSeconds / 3600);

  const minutes =
    Math.floor(
      (dealSeconds % 3600) / 60
    );

  const seconds =
    dealSeconds % 60;

  const hoursElement =
    document.getElementById("hours");

  const minutesElement =
    document.getElementById("minutes");

  const secondsElement =
    document.getElementById("seconds");

  if (hoursElement) {
    hoursElement.textContent =
      String(hours).padStart(2, "0");
  }

  if (minutesElement) {
    minutesElement.textContent =
      String(minutes).padStart(2, "0");
  }

  if (secondsElement) {
    secondsElement.textContent =
      String(seconds).padStart(2, "0");
  }

  dealSeconds--;

}


setInterval(
  updateCountdown,
  1000
);

updateCountdown();


/* ================= TOAST ================= */

let toastTimer;


function showToast(message) {

  if (!toast || !toastText) return;

  toastText.textContent =
    message;

  toast.classList.add("active");

  clearTimeout(toastTimer);

  toastTimer =
    setTimeout(
      () => {

        toast.classList.remove(
          "active"
        );

      },
      2500
    );

}


/* ================= NOTICE ================= */

const closeNotice =
  document.getElementById("closeNotice");

if (closeNotice) {

  closeNotice.addEventListener(
    "click",
    () => {

      const demoNotice =
        document.getElementById("demoNotice");

      if (demoNotice) {
        demoNotice.style.display = "none";
      }

    }
  );

}


/* ================= LOGIN MODAL ================= */

const loginModalOverlay = document.getElementById("loginModalOverlay");
const accountBtn = document.getElementById("accountBtn");
const sidebarAccountBtn = document.getElementById("sidebarAccountBtn");
const loginModalClose = document.getElementById("loginModalClose");
const accountGreeting = document.getElementById("accountGreeting");
const sidebarGreeting = document.getElementById("sidebarGreeting");

function openLoginModal() {
  if (!loginModalOverlay) return;
  loginModalOverlay.classList.add("active");
  document.body.classList.add("modal-open");
}

function closeLoginModal() {
  if (!loginModalOverlay) return;
  loginModalOverlay.classList.remove("active");
  document.body.classList.remove("modal-open");
}

function setLoggedInUser(name) {
  localStorage.setItem("shopnovaUser", name);
  if (accountGreeting) accountGreeting.textContent = `Hello, ${name}`;
  if (sidebarGreeting) sidebarGreeting.textContent = `Hello, ${name}`;
}

const savedUser = localStorage.getItem("shopnovaUser");
if (savedUser) {
  setLoggedInUser(savedUser);
}

if (accountBtn) {
  accountBtn.addEventListener("click", openLoginModal);
}

if (sidebarAccountBtn) {
  sidebarAccountBtn.addEventListener("click", () => {
    closeSidebar();
    openLoginModal();
  });
}

if (loginModalClose) {
  loginModalClose.addEventListener("click", closeLoginModal);
}

if (loginModalOverlay) {
  loginModalOverlay.addEventListener("click", event => {
    if (event.target === loginModalOverlay) {
      closeLoginModal();
    }
  });
}

document.querySelectorAll(".login-tab").forEach(tab => {
  tab.addEventListener("click", () => {

    document.querySelectorAll(".login-tab").forEach(t => t.classList.remove("active"));
    tab.classList.add("active");

    const target = tab.dataset.tab;

    document.querySelectorAll(".login-form").forEach(form => {
      form.classList.toggle("active", form.dataset.form === target);
    });

  });
});

const signinForm = document.getElementById("signinForm");

if (signinForm) {
  signinForm.addEventListener("submit", event => {
    event.preventDefault();

    const emailField = document.getElementById("signinEmail");
    const email = emailField ? emailField.value.trim() : "";

    if (!email) {
      showToast("Please enter your email or mobile number");
      return;
    }

    const name = email.includes("@") ? email.split("@")[0] : email;

    setLoggedInUser(name);
    closeLoginModal();
    showToast(`Welcome back, ${name}!`);
    signinForm.reset();

  });
}

const signupForm = document.getElementById("signupForm");

if (signupForm) {
  signupForm.addEventListener("submit", event => {
    event.preventDefault();

    const nameField = document.getElementById("signupName");
    const name = nameField ? nameField.value.trim() : "";

    if (!name) {
      showToast("Please enter your name");
      return;
    }

    setLoggedInUser(name);
    closeLoginModal();
    showToast(`Account created — welcome, ${name}!`);
    signupForm.reset();

  });
}


/* ================= LOCATION MODAL ================= */

const cities = [
  "Mumbai", "Delhi", "Bengaluru", "Hyderabad",
  "Ahmedabad", "Chennai", "Kolkata", "Pune",
  "Jaipur", "Surat", "Lucknow", "Chandigarh"
];

const locationModalOverlay = document.getElementById("locationModalOverlay");
const deliveryBtn = document.getElementById("deliveryBtn");
const deliveryLocation = document.getElementById("deliveryLocation");
const locationModalClose = document.getElementById("locationModalClose");
const locationGrid = document.getElementById("locationGrid");
const locationSearch = document.getElementById("locationSearch");

function renderLocationGrid(filter = "") {

  if (!locationGrid) return;

  const filtered = cities.filter(city =>
    city.toLowerCase().includes(filter.toLowerCase())
  );

  if (filtered.length === 0) {
    locationGrid.innerHTML = `<div class="location-empty">No matching city found.</div>`;
    return;
  }

  locationGrid.innerHTML = filtered.map(city => `
    <button class="location-item" data-city="${city}">
      <i class="fa-solid fa-location-dot"></i>
      ${city}
    </button>
  `).join("");

}

function openLocationModal() {
  if (!locationModalOverlay) return;
  renderLocationGrid();
  if (locationSearch) locationSearch.value = "";
  locationModalOverlay.classList.add("active");
  document.body.classList.add("modal-open");
}

function closeLocationModal() {
  if (!locationModalOverlay) return;
  locationModalOverlay.classList.remove("active");
  document.body.classList.remove("modal-open");
}

const savedLocation = localStorage.getItem("shopnovaLocation");
if (savedLocation && deliveryLocation) {
  deliveryLocation.textContent = savedLocation;
}

if (deliveryBtn) {
  deliveryBtn.addEventListener("click", openLocationModal);
}

if (locationModalClose) {
  locationModalClose.addEventListener("click", closeLocationModal);
}

if (locationModalOverlay) {
  locationModalOverlay.addEventListener("click", event => {
    if (event.target === locationModalOverlay) {
      closeLocationModal();
    }
  });
}

if (locationSearch) {
  locationSearch.addEventListener("input", () => {
    renderLocationGrid(locationSearch.value.trim());
  });
}

if (locationGrid) {
  locationGrid.addEventListener("click", event => {

    const item = event.target.closest("[data-city]");

    if (!item) return;

    const city = item.dataset.city;

    if (deliveryLocation) {
      deliveryLocation.textContent = city;
    }

    localStorage.setItem("shopnovaLocation", city);

    closeLocationModal();

    showToast(`Delivery location set to ${city}`);

  });
}


/* ================= CHECKOUT MODAL ================= */

const checkoutBtn = document.getElementById("checkoutBtn");
const checkoutModalOverlay = document.getElementById("checkoutModalOverlay");
const checkoutModalClose = document.getElementById("checkoutModalClose");
const checkoutOrderItems = document.getElementById("checkoutOrderItems");
const checkoutSubtotal = document.getElementById("checkoutSubtotal");
const checkoutGrandTotal = document.getElementById("checkoutGrandTotal");
const checkoutOrderId = document.getElementById("checkoutOrderId");

function goToCheckoutStep(step) {

  document.querySelectorAll(".checkout-panel").forEach(panel => {
    panel.classList.toggle("active", Number(panel.dataset.panel) === step);
  });

  document.querySelectorAll(".checkout-step").forEach(stepEl => {
    const stepNum = Number(stepEl.dataset.step);
    stepEl.classList.toggle("active", stepNum === step);
    stepEl.classList.toggle("done", stepNum < step);
  });

}

function renderCheckoutReview() {

  if (!checkoutOrderItems) return;

  let total = 0;

  checkoutOrderItems.innerHTML = cart.map(item => {

    const product = products.find(p => p.id === item.id);

    if (!product) return "";

    const lineTotal = product.price * item.quantity;
    total += lineTotal;

    return `
      <div class="checkout-order-item">
        <img src="${product.image}" alt="${product.name}">
        <div class="checkout-order-item-info">
          <strong>${product.name}</strong>
          <span>Qty: ${item.quantity}</span>
        </div>
        <div class="checkout-order-item-price">${formatPrice(lineTotal)}</div>
      </div>
    `;

  }).join("");

  if (checkoutSubtotal) checkoutSubtotal.textContent = formatPrice(total);
  if (checkoutGrandTotal) checkoutGrandTotal.textContent = formatPrice(total);

}

function openCheckoutModal() {
  if (!checkoutModalOverlay) return;
  goToCheckoutStep(1);
  checkoutModalOverlay.classList.add("active");
  document.body.classList.add("modal-open");
  closeCart();
}

function closeCheckoutModal() {
  if (!checkoutModalOverlay) return;
  checkoutModalOverlay.classList.remove("active");
  document.body.classList.remove("modal-open");
}

if (checkoutBtn) {
  checkoutBtn.addEventListener("click", () => {

    if (cart.length === 0) {
      showToast("Your cart is empty");
      return;
    }

    openCheckoutModal();

  });
}

if (checkoutModalClose) {
  checkoutModalClose.addEventListener("click", closeCheckoutModal);
}

if (checkoutModalOverlay) {
  checkoutModalOverlay.addEventListener("click", event => {
    if (event.target === checkoutModalOverlay) {
      closeCheckoutModal();
    }
  });
}

const toStep2 = document.getElementById("toStep2");

if (toStep2) {
  toStep2.addEventListener("click", () => {

    const name = document.getElementById("checkoutName");
    const phone = document.getElementById("checkoutPhone");
    const address = document.getElementById("checkoutAddress");
    const city = document.getElementById("checkoutCity");
    const pincode = document.getElementById("checkoutPincode");

    if (
      !name.value.trim() ||
      !phone.value.trim() ||
      !address.value.trim() ||
      !city.value.trim() ||
      !pincode.value.trim()
    ) {
      showToast("Please fill in all address fields");
      return;
    }

    renderCheckoutReview();
    goToCheckoutStep(2);

  });
}

const toStep1Back = document.getElementById("toStep1Back");

if (toStep1Back) {
  toStep1Back.addEventListener("click", () => goToCheckoutStep(1));
}

const placeOrderBtn = document.getElementById("placeOrderBtn");

if (placeOrderBtn) {
  placeOrderBtn.addEventListener("click", () => {

    const orderId = "SN" + Math.floor(10000 + Math.random() * 89999);

    if (checkoutOrderId) {
      checkoutOrderId.textContent = `#${orderId}`;
    }

    cart = [];
    saveCart();
    renderCart();

    goToCheckoutStep(3);

  });
}

const checkoutDoneBtn = document.getElementById("checkoutDoneBtn");

if (checkoutDoneBtn) {
  checkoutDoneBtn.addEventListener("click", () => {
    closeCheckoutModal();
    showToast("Thanks for shopping with ShopNova!");
  });
}


/* ================= NEWSLETTER ================= */

const subscribeBtn =
  document.getElementById("subscribeBtn");

if (subscribeBtn) {

  subscribeBtn.addEventListener(
    "click",
    () => {

      const newsletterInput =
        document.getElementById(
          "newsletterEmail"
        );

      if (!newsletterInput) return;

      const email =
        newsletterInput.value.trim();

      if (!email) {

        showToast(
          "Please enter your email"
        );

        return;

      }

      if (
        !email.includes("@") ||
        !email.includes(".")
      ) {

        showToast(
          "Please enter a valid email"
        );

        return;

      }

      showToast(
        "Thanks! You're subscribed 🎉"
      );

      newsletterInput.value = "";

    }
  );

}


/* ================= BACK TO TOP ================= */

const backTop =
  document.getElementById("backTop");


if (backTop) {

  window.addEventListener(
    "scroll",
    () => {

      backTop.classList.toggle(
        "active",
        window.scrollY > 500
      );

    }
  );

  backTop.addEventListener(
    "click",
    () => {

      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });

    }
  );

}


/* ================= LOGO ================= */

const logoBtn =
  document.getElementById("logoBtn");

if (logoBtn) {

  logoBtn.addEventListener(
    "click",
    event => {

      event.preventDefault();

      currentCategory = "all";
      currentSearch = "";

      if (searchInput) {
        searchInput.value = "";
      }

      if (productTitle) {
        productTitle.textContent =
          "Popular Products";
      }

      renderProducts();

      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });

    }
  );

}


/* ================= ESC KEY ================= */

document.addEventListener(
  "keydown",
  event => {

    if (event.key !== "Escape") return;

    closeCart();
    closeSidebar();
    closeProductModal();
    closeLoginModal();
    closeLocationModal();
    closeCheckoutModal();

  }
);


/* ================= SCROLL REVEAL ================= */

function initReveal() {

  const elements =
    document.querySelectorAll(
      ".reveal:not(.visible)"
    );

  if (!elements.length) return;

  const observer =
    new IntersectionObserver(
      entries => {

        entries.forEach(entry => {

          if (entry.isIntersecting) {

            entry.target.classList.add(
              "visible"
            );

            observer.unobserve(
              entry.target
            );

          }

        });

      },
      {
        threshold: .12
      }
    );

  elements.forEach(
    element =>
      observer.observe(element)
  );

}


/* ================= INITIAL ================= */

const year =
  document.getElementById("year");

if (year) {
  year.textContent =
    new Date().getFullYear();
}


/* RENDER ALL SECTIONS */

renderProducts();
