let cart = JSON.parse(localStorage.getItem("shopnovaCart")) || [];
let wishlist = JSON.parse(localStorage.getItem("shopnovaWishlist")) || [];

let currentCategory = "all";
let currentSearch = "";

let adIndex = 0;
let adTimer;

let dealSeconds = 8 * 60 * 60 + 42 * 60 + 19;


/* ================= LIVE / REAL-TIME STATE ================= */

/* Live viewer counts per product id (simulated real-time browsing activity) */
const liveViewerCounts = {};

/* Live stock levels per product id (simulated real-time inventory) */
const liveStockLevels = {};

products.forEach(product => {
  liveViewerCounts[product.id] = 6 + Math.floor(Math.random() * 45);
  /* Higher rated / more reviewed products run lower stock more often, like real bestsellers */
  const base = product.reviews > 2500 ? 4 : 8;
  liveStockLevels[product.id] = base + Math.floor(Math.random() * 22);
});

const liveCities = [
  "Mumbai", "Delhi", "Bengaluru", "Ahmedabad", "Pune",
