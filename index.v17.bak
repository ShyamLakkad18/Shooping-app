  <link rel="dns-prefetch" href="https://images.unsplash.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"ShopNova","description":"Modern online shopping for fashion, electronics, home and beauty.","inLanguage":"en-IN"}</script>
  <link rel="stylesheet" href="features7.css">
