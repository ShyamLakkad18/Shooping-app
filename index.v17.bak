<!-- ================= CART ================= -->

<div class="cart-overlay" id="cartOverlay"></div>

<aside class="cart-drawer" id="cartDrawer">

  <div class="cart-header">

    <div>
      <i class="fa-solid fa-cart-shopping"></i>
      <h2>Your Cart</h2>
    </div>

    <button id="closeCart">
      <i class="fa-solid fa-xmark"></i>
    </button>

  </div>


  <div class="cart-items" id="cartItems">

    <div class="empty-cart">
      <i class="fa-solid fa-cart-shopping"></i>
      <h3>Your cart is empty</h3>
      <p>Add products to see them here.</p>
    </div>

  </div>


  <div class="cart-footer">

    <div class="cart-subtotal">
      <span>Subtotal:</span>
      <strong id="cartTotal">₹0</strong>
    </div>

    <button class="checkout-btn" id="checkoutBtn">
      Proceed to Checkout
      <i class="fa-solid fa-arrow-right"></i>
    </button>

    <small>
      Demo checkout. No real payment will be processed.
    </small>

  </div>

</aside>


<!-- ================= MODAL ================= -->

<div class="product-modal-overlay" id="productModalOverlay">

  <div class="product-modal">

    <button class="modal-close" id="modalClose">
      <i class="fa-solid fa-xmark"></i>
    </button>

    <div id="modalContent"></div>

  </div>

</div>


<!-- ================= LOGIN MODAL ================= -->

<div class="login-modal-overlay" id="loginModalOverlay">

  <div class="login-modal">

    <button class="modal-close" id="loginModalClose">
      <i class="fa-solid fa-xmark"></i>
    </button>

    <div class="login-art">
      <div class="login-art-glow"></div>
      <i class="fa-solid fa-bag-shopping login-art-icon"></i>
      <h3>Welcome to ShopNova</h3>
      <p>Sign in for faster checkout, order tracking and personalised deals.</p>
    </div>

    <div class="login-form-wrap">

      <div class="login-tabs">
        <button class="login-tab active" data-tab="signin">Sign In</button>
        <button class="login-tab" data-tab="signup">Create Account</button>
      </div>

      <form class="login-form active" id="signinForm" data-form="signin">

        <label class="login-field">
          <span>Email or Mobile Number</span>
          <input type="text" id="signinEmail" placeholder="you@example.com" required>
        </label>

        <label class="login-field">
          <span>Password</span>
          <input type="password" id="signinPassword" placeholder="••••••••" required>
        </label>

        <button type="submit" class="login-submit">
          Sign In
          <i class="fa-solid fa-arrow-right"></i>
        </button>

        <p class="login-note">Demo login — no real account is created or verified.</p>

      </form>

      <form class="login-form" id="signupForm" data-form="signup">

        <label class="login-field">
          <span>Full Name</span>
          <input type="text" id="signupName" placeholder="Your name" required>
        </label>

        <label class="login-field">
          <span>Email</span>
          <input type="email" id="signupEmail" placeholder="you@example.com" required>
        </label>

        <label class="login-field">
          <span>Password</span>
          <input type="password" id="signupPassword" placeholder="Create a password" required>
        </label>

        <button type="submit" class="login-submit">
          Create Account
          <i class="fa-solid fa-arrow-right"></i>
        </button>

        <p class="login-note">Demo signup — no real account is created or verified.</p>

      </form>

    </div>

  </div>

</div>


<!-- ================= LOCATION MODAL ================= -->

<div class="location-modal-overlay" id="locationModalOverlay">

  <div class="location-modal">

    <div class="location-header">

      <div>
        <i class="fa-solid fa-location-dot"></i>
        Choose Your Location
      </div>

      <button id="locationModalClose">
        <i class="fa-solid fa-xmark"></i>
      </button>

    </div>

    <div class="location-body">

      <input
        type="text"
        id="locationSearch"
        placeholder="Search for a city or pincode"
      >

      <div class="location-grid" id="locationGrid"></div>

    </div>

  </div>

</div>


<!-- ================= CHECKOUT MODAL ================= -->

<div class="checkout-modal-overlay" id="checkoutModalOverlay">

  <div class="checkout-modal">

    <button class="modal-close" id="checkoutModalClose">
      <i class="fa-solid fa-xmark"></i>
    </button>

    <div class="checkout-steps">
      <div class="checkout-step active" data-step="1"><span>1</span>Address</div>
      <div class="checkout-step-line"></div>
      <div class="checkout-step" data-step="2"><span>2</span>Review</div>
      <div class="checkout-step-line"></div>
      <div class="checkout-step" data-step="3"><span>3</span>Done</div>
    </div>

    <!-- STEP 1: ADDRESS -->
    <div class="checkout-panel active" data-panel="1">

      <h3>Shipping Address</h3>

      <div class="checkout-field-row">

        <label class="checkout-field">
          <span>Full Name</span>
          <input type="text" id="checkoutName" placeholder="Your name">
        </label>

        <label class="checkout-field">
          <span>Phone Number</span>
          <input type="tel" id="checkoutPhone" placeholder="10-digit mobile number">
        </label>

      </div>

      <label class="checkout-field">
        <span>Address</span>
        <input type="text" id="checkoutAddress" placeholder="House no, street, area">
      </label>

      <div class="checkout-field-row">

        <label class="checkout-field">
          <span>City</span>
          <input type="text" id="checkoutCity" placeholder="City">
        </label>

        <label class="checkout-field">
          <span>Pincode</span>
          <input type="text" id="checkoutPincode" placeholder="6-digit pincode">
        </label>

      </div>

      <button class="checkout-next-btn" id="toStep2">
        Continue to Review
        <i class="fa-solid fa-arrow-right"></i>
      </button>

    </div>

    <!-- STEP 2: REVIEW -->
    <div class="checkout-panel" data-panel="2">

      <h3>Review Your Order</h3>

      <div class="checkout-order-items" id="checkoutOrderItems"></div>

      <div class="checkout-summary">
        <div><span>Subtotal</span><strong id="checkoutSubtotal">₹0</strong></div>
        <div><span>Delivery</span><strong class="checkout-free">FREE</strong></div>
        <div class="checkout-summary-total"><span>Total</span><strong id="checkoutGrandTotal">₹0</strong></div>
      </div>

      <div class="checkout-panel-actions">
        <button class="checkout-back-btn" id="toStep1Back">
          <i class="fa-solid fa-arrow-left"></i>
          Back
        </button>
        <button class="checkout-next-btn" id="placeOrderBtn">
          Place Order
          <i class="fa-solid fa-check"></i>
        </button>
      </div>

    </div>

    <!-- STEP 3: SUCCESS -->
    <div class="checkout-panel" data-panel="3">

      <div class="checkout-success">

        <div class="checkout-check">
          <i class="fa-solid fa-check"></i>
        </div>

        <h3>Order Placed Successfully!</h3>

        <p>Your order <strong id="checkoutOrderId">#SN00000</strong> has been placed.</p>
        <p class="checkout-demo-note">Demo order — no real payment or shipment is processed.</p>

        <button class="checkout-next-btn" id="checkoutDoneBtn">
          Continue Shopping
        </button>

      </div>

    </div>

  </div>

</div>


<!-- ================= TOAST ================= -->

<div class="toast" id="toast">

  <i class="fa-solid fa-circle-check"></i>

  <span id="toastText">
