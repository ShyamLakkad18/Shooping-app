<body>
<!-- ===== WELCOME SPLASH ===== -->
<div id="splash">
  <span class="sp-orb o1"></span><span class="sp-orb o2"></span><span class="sp-orb o3"></span>
  <div class="sp-center">
    <div class="sp-logo"><i class="fa-solid fa-bag-shopping"></i></div>
    <p class="sp-hello">Welcome to</p>
    <h1 class="sp-title">ShopNova</h1>
    <p class="sp-tag">Fashion · Electronics · Home · Beauty</p>
    <div class="sp-bar"><i></i></div>
  </div>
</div>

<!-- ===== LOGIN GATE ===== -->
<div id="gate">
  <div class="g-art">
    <span class="g-float" style="--x:10%;--y:12%;--d:0s">🛍️</span>
    <span class="g-float" style="--x:74%;--y:8%;--d:.6s">👗</span>
    <span class="g-float" style="--x:82%;--y:52%;--d:1.2s">🎧</span>
    <span class="g-float" style="--x:8%;--y:60%;--d:.9s">👟</span>
    <span class="g-float" style="--x:46%;--y:82%;--d:1.5s">🎁</span>
    <div class="g-art-text">
      <div class="g-brand"><i class="fa-solid fa-bag-shopping"></i> ShopNova</div>
      <h2>Shop smarter.<br>Live better.</h2>
      <ul><li>✔ 100+ products, up to 50% OFF</li><li>✔ Free delivery above ₹999</li><li>✔ Easy 7-day returns</li></ul>
    </div>
  </div>
  <div class="g-panel">
    <div class="g-card">
      <h3>Hello there 👋</h3>
      <p class="g-sub">Sign in to get faster checkout and exclusive deals.</p>
      <div class="g-tabs"><button class="g-tab active" data-t="in">Sign In</button><button class="g-tab" data-t="up">Create Account</button></div>
      <form class="g-form active" data-f="in">
        <input type="text" placeholder="Email or mobile number">
        <input type="password" placeholder="Password">
        <button class="g-submit" type="submit">Sign In <i class="fa-solid fa-arrow-right"></i></button>
      </form>
      <form class="g-form" data-f="up">
        <input type="text" placeholder="Full name">
        <input type="email" placeholder="Email">
        <input type="password" placeholder="Create password">
        <button class="g-submit" type="submit">Create Account <i class="fa-solid fa-arrow-right"></i></button>
      </form>
      <p class="g-err"></p>
      <div class="g-or"><span>or</span></div>
      <button class="g-guest" id="gGuest">Continue as Guest</button>
      <small class="g-note">Demo login. No real account is created.</small>
    </div>
  </div>
</div>


<!-- ================= DEMO NOTICE ================= -->

<div class="demo-notice" id="demoNotice">
  <span>
    <i class="fa-solid fa-circle-info"></i>
    Demo e-commerce website — no real payments or orders are processed.
  </span>

  <button id="closeNotice">
    <i class="fa-solid fa-xmark"></i>
  </button>
</div>


<!-- ================= HEADER ================= -->

<header class="header">

  <div class="top-header">

    <div class="logo">
      <a href="#" id="logoBtn">
        <span class="logo-icon">
          <i class="fa-solid fa-bag-shopping"></i>
        </span>
        <span>Shop<span>Nova</span></span>
      </a>
    </div>


    <button class="delivery" id="deliveryBtn">
      <i class="fa-solid fa-location-dot"></i>

      <div>
        <small>Deliver to</small>
        <strong id="deliveryLocation">India</strong>
      </div>
    </button>


    <div class="search-box">

      <select id="searchCategory">
        <option value="all">All</option>
        <option value="fashion">Fashion</option>
        <option value="electronics">Electronics</option>
        <option value="shoes">Shoes</option>
        <option value="beauty">Beauty</option>
        <option value="home">Home</option>
        <option value="gaming">Gaming</option>
        <option value="books">Books</option>
        <option value="innerwear">Innerwear</option>
      </select>

      <input
        type="search"
        id="searchInput"
        placeholder="Search products..."
      >

      <button id="searchBtn">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>

    </div>


    <div class="header-actions">

      <button class="header-action language">
        <span>🇮🇳</span>
        <small>EN</small>
      </button>

      <button class="header-action account" id="accountBtn">
        <small id="accountGreeting">Hello, Sign in</small>
        <strong>Account & Lists</strong>
      </button>

      <button class="header-action orders">
        <small>Returns</small>
        <strong>& Orders</strong>
      </button>

      <button class="cart-button" id="cartBtn">

        <span class="cart-icon">
          <i class="fa-solid fa-cart-shopping"></i>
          <b id="cartCount">0</b>
        </span>

        <strong>Cart</strong>

      </button>

    </div>

  </div>


  <nav class="nav-bar">

    <button class="menu-btn" id="menuBtn">
      <i class="fa-solid fa-bars"></i>
      All
    </button>

    <a href="#deals">Today's Deals</a>
    <a href="#products">Best Sellers</a>
    <a href="#categories">Categories</a>
    <a href="#men">Men</a>
    <a href="#women">Women</a>
    <a href="#products">Fashion</a>
    <a href="#products">Electronics</a>
    <a href="#products">Home</a>
    <a href="#products">Beauty</a>
    <a href="#products">Gaming</a>
    <a href="#products">Innerwear</a>

  </nav>

</header>

<!-- ================= PROMO MARQUEE ================= -->
<div class="promo-marquee">
  <div class="promo-track">
    <span>🔥 Flat 50% OFF on Fashion</span>
    <span>🚚 Free Delivery Across India</span>
    <span>👗 New Women's Collection Just Landed</span>
    <span>💳 Extra 10% OFF on Prepaid Orders</span>
    <span>↩️ Easy 7-Day Returns</span>
    <span>🔥 Flat 50% OFF on Fashion</span>
    <span>🚚 Free Delivery Across India</span>
    <span>👗 New Women's Collection Just Landed</span>
    <span>💳 Extra 10% OFF on Prepaid Orders</span>
    <span>↩️ Easy 7-Day Returns</span>
  </div>
</div>


<!-- ================= SIDEBAR ================= -->

<div class="overlay" id="overlay"></div>

<aside class="sidebar" id="sidebar">

  <div class="sidebar-header">

    <button class="sidebar-account" id="sidebarAccountBtn">
      <i class="fa-solid fa-user"></i>
      <span id="sidebarGreeting">Hello, Sign in</span>
    </button>

    <button id="closeSidebar">
      <i class="fa-solid fa-xmark"></i>
    </button>

  </div>


  <div class="sidebar-content">

    <h3>Shop By Category</h3>

    <button data-category="all">All Products</button>
    <button data-category="fashion">Fashion</button>
    <button data-category="electronics">Electronics</button>
    <button data-category="shoes">Shoes</button>
    <button data-category="beauty">Beauty</button>
    <button data-category="home">Home</button>
    <button data-category="gaming">Gaming</button>
    <button data-category="books">Books</button>
    <button data-category="innerwear">Innerwear & Loungewear</button>

    <hr>

    <h3>Customer Service</h3>

    <button id="sidebarOrders">My Orders</button>
    <button id="sidebarWishlist">Wishlist</button>
    <button id="sidebarHelp">Help Center</button>

  </div>

</aside>


<main>

<!-- ================= MODERN HERO AD ================= -->

<section class="hero-ad" id="heroAd">

  <div class="ad-slider" id="adSlider">


    <!-- AD 1 -->

    <article class="ad-slide active">

      <div class="ad-background"></div>

      <div class="ad-content">

        <span class="ad-label">
