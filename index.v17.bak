    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="features.css">
  <link rel="stylesheet" href="features3.css">
  <link rel="stylesheet" href="features4.css">
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#101820">
  <link rel="stylesheet" href="features5.css">
  <link rel="stylesheet" href="features6.css">
  <title>ShopNova - Online Shopping for Fashion, Electronics, Home &amp; Beauty | Free Delivery</title>
  <meta name="description" content="Shop 250+ products at up to 50% OFF on ShopNova: men, women and kids fashion, electronics, shoes, home, beauty, gaming and books. Free delivery above Rs 999 and easy 7-day returns.">
  <meta name="keywords" content="online shopping, fashion, electronics, shoes, home decor, beauty, kids, gaming, books, India">
  <meta name="robots" content="index, follow">
  <meta property="og:type" content="website">
